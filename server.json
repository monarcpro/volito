{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.monarcpro/volito",
  "title": "Volito",
  "description": "Motion graphics as code: find, preview and render lower thirds, titles, charts and 3D to video",
  "version": "0.3.0",
  "websiteUrl": "https://volito.dev",
  "repository": {
    "url": "https://github.com/monarcpro/volito",
    "source": "github",
    "id": "1431592139"
  },
  "icons": [
    {
      "src": "https://volito.dev/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://volito.dev/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "volito",
      "version": "0.3.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
