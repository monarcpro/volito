{
  "name": "volito",
  "version": "0.1.1",
  "type": "module",
  "description": "Volito by MONARC STUDIOS: brand-aware, voice-synced motion graphics as code. Packs of ready-made graphics, a CLI, a Node API and an MCP server that render them to ProRes 4444, WebM, MP4, GIF, PNG or SVG.",
  "license": "(MIT AND LicenseRef-MONARC-Packs-1.0)",
  "author": "MONARC STUDIOS <hello@monarcpro.app>",
  "homepage": "https://volito.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monarcpro/volito.git"
  },
  "bugs": {
    "url": "https://github.com/monarcpro/volito/issues"
  },
  "keywords": [
    "volito",
    "motion graphics",
    "video",
    "svg",
    "animation",
    "lower third",
    "title",
    "mcp",
    "ai agents",
    "prores",
    "render"
  ],
  "bin": {
    "volito": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "packs",
    "libs",
    "fonts",
    "skill",
    "examples",
    "LICENSE",
    "PACKS-LICENSE.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18"
    }
  },
  "scripts": {
    "fonts": "node scripts/build-fonts.mjs",
    "build": "node scripts/build-fonts.mjs && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/build-fonts.mjs && vitest run",
    "sync-engine": "node scripts/sync-engine.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@resvg/resvg-js": "2.6.2",
    "fontkit": "2.0.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/caveat": "5.2.7",
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/gabarito": "5.3.0",
    "@fontsource/im-fell-english": "5.3.0",
    "@fontsource/inter": "5.2.7",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/orbitron": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@fontsource/pacifico": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "@fontsource/permanent-marker": "5.3.0",
    "@fontsource/playfair-display": "5.2.7",
    "@fontsource/poppins": "5.2.7",
    "@fontsource/press-start-2p": "5.3.0",
    "@fontsource/righteous": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@fontsource/syne": "5.3.0",
    "@fontsource/unbounded": "5.3.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "rollup": "4.64.0",
    "rollup-plugin-dts": "6.5.1",
    "topojson-client": "3.1.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "world-atlas": "2.0.2"
  },
  "packageManager": "pnpm@10.17.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
