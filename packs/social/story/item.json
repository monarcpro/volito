    "max": 30
  },
  "props": {
    "name": {
      "type": "text",
      "label": "Name",
      "default": "Monarc Studio",
      "maxLength": 30
    },
    "time": {
      "type": "text",
      "label": "Time",
      "default": "2h",
      "maxLength": 8
    },
    "segments": {
      "type": "number",
      "label": "Segments",
      "default": 4,
