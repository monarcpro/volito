{
  "id": "story",
  "name": "Story frame",
  "description": "A story's frame over your footage: progress segments along the top with the current one filling, the poster's badge, name and time, a tilted caption sticker and the reply bar.",
  "category": "social",
  "tags": [
    "story",
    "stories",
    "reels",
    "overlay",
    "vertical"
  ],
  "placement": "overlay",
