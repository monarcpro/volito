      "max": 8
    },
    "current": {
      "type": "number",
      "label": "Current",
      "default": 2,
      "min": 1,
      "max": 8
    },
    "caption": {
      "type": "text",
      "label": "Sticker",
      "default": "New cut drops Friday",
      "maxLength": 50
    },
    "reply": {
      "type": "boolean",
      "label": "Reply bar",
      "default": true
    }
  },
  "parts": {
    "segments": "the progress segments",
    "poster": "the badge, name and time",
    "sticker": "the caption sticker",
    "reply": "the reply bar"
  },
  "beats": {
    "in": 0.15,
    "out": -0.45
  }
