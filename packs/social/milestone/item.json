    "label": {
      "type": "text",
      "label": "Counts",
      "default": "",
      "maxLength": 20
    },
    "platform": {
      "type": "choice",
      "label": "Platform",
      "options": [
        "youtube",
        "instagram",
        "tiktok",
        "x",
        "linkedin",
        "threads",
        "website"
      ],
      "default": "youtube"
    },
    "line": {
      "type": "text",
      "label": "Line",
      "default": "Thank you for 100K!",
      "maxLength": 40
    }
  },
  "parts": {
    "badge": "the badge",
    "confetti": "the confetti",
    "line": "the line under it"
  },
  "beats": {
    "in": 0.15,
    "out": -0.45
  }
