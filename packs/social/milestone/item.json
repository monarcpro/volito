{
  "id": "milestone",
  "name": "Milestone",
  "description": "A milestone badge: the platform's icon and the count rolling up to the goal; at the goal it pops, confetti bursts and the thank-you line rises under it.",
  "category": "social",
  "tags": [
    "milestone",
    "followers",
    "subscribers",
    "celebration",
    "thank you"
  ],
  "placement": "overlay",
