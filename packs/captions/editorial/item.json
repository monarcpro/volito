{
  "id": "editorial",
  "name": "Editorial captions",
  "description": "Magazine captions: the line in the brand's text face with its key word set far bigger in the accent face — the *starred* words, else the longest word of each phrase — every word rising in as it is said. Give a transcript with --words.",
  "category": "captions",
  "tags": [
    "captions",
    "editorial",
    "magazine",
    "serif",
    "emphasis",
    "transcript",
    "interview"
  ],
  "placement": "overlay",
  "duration": {
    "default": 6,
    "min": 1,
    "max": 120
  },
  "aspects": [
    "9:16",
    "16:9",
    "1:1",
    "4:5"
  ],
  "props": {
    "text": {
      "type": "longtext",
      "label": "Text",
      "description": "what is said; leave empty to caption the transcript as it is. Wrap a word in *stars* for the accent",
      "default": "The best stories are told *slowly*.",
      "maxLength": 600
    },
    "accents": {
      "type": "text",
      "label": "Accent words",
      "description": "words to put in the accent wherever they are said, comma separated",
      "default": "",
      "maxLength": 120
    },
    "position": {
      "type": "choice",
      "label": "Position",
      "options": [
        "bottom",
        "center",
        "top"
      ],
      "default": "bottom"
    },
    "size": {
      "type": "choice",
      "label": "Size",
      "options": [
        "medium",
        "small",
        "large"
      ],
      "default": "medium"
    },
    "case": {
      "type": "choice",
      "label": "Case",
      "options": [
        "as typed",
        "upper",
        "lower",
        "style"
      ],
      "default": "as typed"
    },
    "pace": {
      "type": "number",
      "label": "Seconds per word",
      "description": "without a transcript",
      "default": 0.32,
      "min": 0.08,
      "max": 2,
      "step": 0.01
    },
    "ticks": {
      "type": "boolean",
      "label": "Sound on every word",
      "default": false
    },
    "emphasis": {
      "type": "choice",
      "label": "Emphasis",
      "options": [
        "auto",
        "marked"
      ],
      "default": "auto",
      "description": "auto: lift the longest word of each phrase when none is starred · marked: only starred or listed words"
    },
    "contrast": {
      "type": "choice",
      "label": "Size contrast",
      "options": [
        "standard",
        "subtle",
        "dramatic"
      ],
      "default": "standard"
    },
    "upcoming": {
      "type": "choice",
      "label": "Words not said yet",
      "options": [
        "dim",
        "hidden"
      ],
      "default": "dim"
    }
  },
  "beats": {
    "in": 0.05
  },
  "parts": {
    "words": "the caption words and everything drawn with them"
  }
}
