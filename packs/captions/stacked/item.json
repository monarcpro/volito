{
  "id": "stacked",
  "name": "Stacked captions",
  "description": "Short lines stack up the frame: the newest at the bottom at full size, its words popping in as they are said, while the lines before it rise, shrink and fade. Give a transcript with --words.",
  "category": "captions",
  "tags": [
    "captions",
    "stack",
    "rolling",
    "transcript",
    "social",
    "reels",
    "podcast"
  ],
  "placement": "overlay",
  "duration": {
    "default": 6,
    "min": 1,
    "max": 120
  },
  "aspects": [
    "9:16",
    "16:9",
    "1:1",
    "4:5"
  ],
  "props": {
    "text": {
      "type": "longtext",
      "label": "Text",
      "description": "what is said; leave empty to caption the transcript as it is. Wrap a word in *stars* for the accent",
      "default": "Short lines that stack up as you keep on talking.",
      "maxLength": 600
    },
    "accents": {
      "type": "text",
      "label": "Accent words",
      "description": "words to put in the accent wherever they are said, comma separated",
      "default": "",
      "maxLength": 120
    },
    "position": {
      "type": "choice",
      "label": "Position",
      "options": [
        "center",
        "bottom",
        "top"
      ],
      "default": "center"
    },
    "size": {
      "type": "choice",
      "label": "Size",
      "options": [
        "medium",
        "small",
        "large"
      ],
      "default": "medium"
    },
    "case": {
      "type": "choice",
      "label": "Case",
      "options": [
        "as typed",
        "upper",
        "lower",
        "style"
      ],
      "default": "as typed"
    },
    "pace": {
      "type": "number",
      "label": "Seconds per word",
      "description": "without a transcript",
      "default": 0.32,
      "min": 0.08,
      "max": 2,
      "step": 0.01
    },
    "ticks": {
      "type": "boolean",
      "label": "Sound on every word",
      "default": false
    },
    "lines": {
      "type": "choice",
      "label": "Lines kept",
      "options": [
        "three",
        "two"
      ],
      "default": "three"
    }
  },
  "beats": {
    "in": 0.05
  },
  "parts": {
    "words": "the caption words and everything drawn with them"
  }
}
