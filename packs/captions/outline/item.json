{
  "id": "outline",
  "name": "Outline captions",
  "description": "The line hangs as hollow outlines and each word fills solid from the left as it is said. Give a transcript with --words.",
  "category": "captions",
  "tags": [
    "captions",
    "outline",
    "stroke",
    "fill",
    "transcript",
    "social"
  ],
  "placement": "overlay",
  "duration": {
    "default": 6,
    "min": 1,
    "max": 120
  },
  "aspects": [
    "9:16",
    "16:9",
    "1:1",
    "4:5"
  ],
  "props": {
    "text": {
      "type": "longtext",
      "label": "Text",
      "description": "what is said; leave empty to caption the transcript as it is. Wrap a word in *stars* for the accent",
      "default": "Hollow words that fill as you *speak.*",
      "maxLength": 600
    },
    "accents": {
      "type": "text",
      "label": "Accent words",
      "description": "words to put in the accent wherever they are said, comma separated",
      "default": "",
      "maxLength": 120
    },
    "position": {
      "type": "choice",
      "label": "Position",
      "options": [
        "center",
        "bottom",
        "top"
      ],
      "default": "center"
    },
    "size": {
      "type": "choice",
      "label": "Size",
      "options": [
        "medium",
        "small",
        "large"
      ],
      "default": "medium"
    },
    "case": {
      "type": "choice",
      "label": "Case",
      "options": [
        "upper",
        "as typed",
        "lower",
        "style"
      ],
      "default": "upper"
    },
    "pace": {
      "type": "number",
      "label": "Seconds per word",
      "description": "without a transcript",
      "default": 0.32,
      "min": 0.08,
      "max": 2,
      "step": 0.01
    },
    "fill": {
      "type": "choice",
      "label": "Fill",
      "options": [
        "white",
        "accent"
      ],
      "default": "white"
    }
  },
  "beats": {
    "in": 0.05
  },
  "parts": {
    "words": "the caption words and everything drawn with them"
  }
}
