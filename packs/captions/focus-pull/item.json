{
  "id": "focus-pull",
  "name": "Focus captions",
  "description": "The whole line on screen with the word being said pulled into sharp focus while the rest sits soft and dim around it. Give a transcript with --words.",
  "category": "captions",
  "tags": [
    "captions",
    "focus",
    "blur",
    "cinematic",
    "transcript",
    "interview"
  ],
  "placement": "overlay",
  "duration": {
    "default": 6,
    "min": 1,
    "max": 120
  },
  "aspects": [
    "9:16",
    "16:9",
    "1:1",
    "4:5"
  ],
  "props": {
    "text": {
      "type": "longtext",
      "label": "Text",
      "description": "what is said; leave empty to caption the transcript as it is. Wrap a word in *stars* for the accent",
      "default": "Only the word being said is in *focus.*",
      "maxLength": 600
    },
    "accents": {
      "type": "text",
      "label": "Accent words",
      "description": "words to put in the accent wherever they are said, comma separated",
      "default": "",
      "maxLength": 120
    },
    "position": {
      "type": "choice",
      "label": "Position",
      "options": [
        "bottom",
        "center",
        "top"
      ],
      "default": "bottom"
    },
    "size": {
      "type": "choice",
      "label": "Size",
      "options": [
        "medium",
        "small",
        "large"
      ],
      "default": "medium"
    },
    "case": {
      "type": "choice",
      "label": "Case",
      "options": [
        "as typed",
        "upper",
        "lower",
        "style"
      ],
      "default": "as typed"
    },
    "pace": {
      "type": "number",
      "label": "Seconds per word",
      "description": "without a transcript",
      "default": 0.32,
      "min": 0.08,
      "max": 2,
      "step": 0.01
    },
    "depth": {
      "type": "choice",
      "label": "Blur",
      "options": [
        "standard",
        "light",
        "deep"
      ],
      "default": "standard"
    }
  },
  "beats": {
    "in": 0.05
  },
  "parts": {
    "words": "the caption words and everything drawn with them"
  }
}
