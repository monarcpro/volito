      "label": "Periods",
      "default": [
        "2022",
        "2023",
        "2024",
        "2025",
        "2026"
      ],
      "maxItems": 12,
      "minItems": 2,
      "of": "text"
    },
    "rows": {
      "type": "list",
      "label": "Rows (Name: v1, v2, …)",
      "default": [
        {
          "label": "MONARC",
          "values": "4, 14, 38, 72, 118"
        },
        {
          "label": "Studio A",
          "values": "60, 66, 70, 71, 72"
        },
        {
          "label": "Cutter",
          "values": "40, 48, 52, 50, 46"
        },
        {
          "label": "Frame.io",
          "values": "22, 30, 41, 47, 51"
        },
        {
          "label": "Clipmate",
          "values": "35, 30, 24, 20, 18"
        },
        {
          "label": "Reelsy",
          "values": "8, 20, 33, 44, 49"
        }
      ],
      "maxItems": 12,
      "minItems": 2,
      "of": {
        "label": "text",
        "values": "text"
      }
