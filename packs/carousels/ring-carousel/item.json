{
  "id": "ring-carousel",
  "name": "Ring carousel",
  "description": "Cards round a ring seen from just above: it swings one card at a time, fast then slow, cards shrinking and fading round the back, the one in front named underneath. Your pictures, or tiles in the brand's colours.",
  "category": "scene",
  "tags": [
    "carousel",
    "ring",
    "gallery",
    "3d",
    "portfolio"
  ],
  "placement": "full",
  "duration": {
    "default": 8,
    "min": 3,
    "max": 60
  },
  "props": {
    "title": {
      "type": "text",
      "label": "Title",
      "default": "The collection",
      "maxLength": 50
    },
    "cards": {
      "type": "list",
      "label": "Cards (Title: tag)",
      "default": [
        {
          "title": "Morning light",
          "tag": "Lookbook 01"
        },
        {
          "title": "City nights",
          "tag": "Lookbook 02"
        },
        {
          "title": "Studio session",
          "tag": "Behind the scenes"
        },
        {
          "title": "Coastline",
          "tag": "Travel"
        },
        {
          "title": "Golden hour",
          "tag": "Portraits"
        },
        {
          "title": "Night market",
          "tag": "Street"
        },
        {
          "title": "Snow days",
          "tag": "Winter"
        },
        {
          "title": "Road trip",
          "tag": "Travel"
        }
      ],
      "maxItems": 16,
      "minItems": 1,
      "of": {
        "title": "text",
        "tag": "text"
      }
    },
    "count": {
      "type": "number",
      "label": "Cards",
      "default": 10,
      "min": 4,
      "max": 16
    },
    "pace": {
      "type": "number",
      "label": "Seconds per card",
      "default": 1.1,
      "min": 0.6,
      "max": 4,
      "step": 0.1
    },
    "direction": {
      "type": "choice",
      "label": "Turns",
      "options": [
        "right",
        "left"
      ],
      "default": "right"
    },
    "image1": {
      "type": "image",
